<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pharmalab.labtrack.persistence.TestParameterMapper">

	<sql id="columns">
		id, code, name, unit, spec_min, spec_max, active, display_order
	</sql>

	<select id="findAll" resultType="TestParameter">
		SELECT <include refid="columns"/>
		FROM test_parameter
		ORDER BY display_order
	</select>

	<select id="findById" resultType="TestParameter">
		SELECT <include refid="columns"/>
		FROM test_parameter
		WHERE id = #{id}
	</select>

	<select id="findByCode" resultType="TestParameter">
		SELECT <include refid="columns"/>
		FROM test_parameter
		WHERE code = #{code}
	</select>

</mapper>
